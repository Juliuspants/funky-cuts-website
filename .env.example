# Port, auf dem der Server läuft
PORT=3000

# Geheimer Schlüssel zum Signieren der Admin-Login-Sitzung.
# Vor dem ersten Start durch eine eigene lange Zufallszeichenkette ersetzen!
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte_ersetzen_mit_langem_zufallswert

# Name des Salons, wird im Frontend angezeigt
SALON_NAME=Funky Cuts

# Zeitzone für Öffnungszeiten/Termine (wichtig, falls der Server im Ausland gehostet wird)
TZ=Europe/Berlin
