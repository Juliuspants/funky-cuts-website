# Port, auf dem der Server bei lokaler Entwicklung läuft (auf Netlify ungenutzt)
PORT=3000

# Verbindungs-URL zur Supabase-Postgres-Datenbank.
# Supabase-Dashboard → Project Settings → Database → Connection string →
# "Connection pooling" (Modus "Transaction") verwenden, nicht die direkte
# Verbindung — die läuft über einen Pooler und funktioniert zuverlässig auch
# aus Serverless-Functions heraus. Passwort wird beim Anlegen des Projekts
# festgelegt (bei Bedarf im Dashboard zurücksetzen).
DATABASE_URL=postgresql://postgres.xxxxxxxx:DEIN_PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Geheimer Schlüssel zum Signieren der Admin-Login-Sitzung.
# Vor dem ersten Start durch eine eigene lange Zufallszeichenkette ersetzen!
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte_ersetzen_mit_langem_zufallswert

# Name des Salons, wird im Frontend angezeigt
SALON_NAME=Funky Cuts
# Kontakt-Mail, wird unten im Footer der Website angezeigt
CONTACT_EMAIL=funkycuts30@gmail.com

# Zeitzone für Öffnungszeiten/Termine (wichtig, falls der Server im Ausland gehostet wird)
TZ=Europe/Berlin

# --- E-Mail (optional) ------------------------------------------------------
# Wird SMTP_HOST nicht gesetzt, verschickt die App einfach keine E-Mails —
# alles andere funktioniert trotzdem ganz normal.
#
# Kunden bekommen dann automatisch eine Bestätigung bei der Buchung und eine
# Nachricht, falls ein Termin storniert wird.
#
# Mit Gmail (funkycuts30@gmail.com): dort ein "App-Passwort" erzeugen (nicht
# das normale Passwort verwenden), braucht 2-Faktor-Auth auf dem Google-Konto:
# https://myaccount.google.com/apppasswords
# Hinweis: ganz frisch angelegte Google-Konten lassen oft 24–48h lang noch
# keine App-Passwörter zu — notfalls übergangsweise ein bereits länger
# bestehendes Gmail-Konto eintragen, später einfach zurück umstellen.
# Alternativ z.B. Brevo/Sendinblue (kostenloser Tarif, kein Gmail nötig).
#
# Port 465 (implizites TLS) verwenden, nicht 587 — aus Netlify Functions
# heraus kam es über 587/STARTTLS zu "Greeting never received"-Fehlern.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=funkycuts30@gmail.com
SMTP_PASS=
SMTP_FROM=Funky Cuts <funkycuts30@gmail.com>

# An diese Adresse geht bei jeder neuen Buchung sowie jedem neuen
# Warteliste-Eintrag eine Kopie raus
ADMIN_NOTIFY_EMAIL=funkycuts30@gmail.com

# Basis-URL der Website — wird für Links in E-Mails gebraucht (z.B. "jetzt
# buchen"-Link, wenn durch eine Stornierung ein Warteliste-Platz frei wird).
# Ohne Angabe wird https://funkycuts.de angenommen.
SITE_URL=https://funkycuts.de
